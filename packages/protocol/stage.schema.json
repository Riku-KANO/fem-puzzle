{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stress-carve.local/stage.schema.json",
  "title": "STRESS CARVE stage",
  "description": "See docs/specs/stage-format.md. Semantic checks (subset relations, cells inside solid) are done by validateStage / Stage::validate.",
  "type": "object",
  "required": ["version", "id", "grid", "voxelSize", "material", "solid", "keep", "supports", "targets"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string" },
    "world": { "type": "integer", "minimum": 0, "maximum": 5 },
    "grid": { "$ref": "#/$defs/ivec3" },
    "voxelSize": { "type": "number", "exclusiveMinimum": 0 },
    "material": {
      "type": "object",
      "required": ["E", "nu", "allowable"],
      "additionalProperties": false,
      "properties": {
        "E": { "type": "number", "exclusiveMinimum": 0 },
        "nu": { "type": "number", "exclusiveMinimum": -1, "exclusiveMaximum": 0.5 },
        "allowable": { "type": "number", "exclusiveMinimum": 0 },
        "density": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "solid": { "$ref": "#/$defs/bitmask" },
    "keep": { "$ref": "#/$defs/bitmask" },
    "block": { "$ref": "#/$defs/bitmask" },
    "supports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["face", "fix"],
        "additionalProperties": false,
        "properties": {
          "face": { "$ref": "#/$defs/face" },
          "fix": { "type": "string", "pattern": "^[xyz]{1,3}$" },
          "cells": { "type": "array", "items": { "$ref": "#/$defs/ivec3" } }
        }
      }
    },
    "loads": { "type": "array", "items": { "$ref": "#/$defs/load" } },
    "loadCases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "loads"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "loads": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/load" } }
        }
      }
    },
    "maxDisplacement": { "type": "number", "exclusiveMinimum": 0 },
    "targets": {
      "type": "object",
      "required": ["star1", "star2", "star3"],
      "additionalProperties": false,
      "properties": {
        "star1": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "star2": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "star3": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "benchmark": {
      "type": "object",
      "required": ["volume", "solid"],
      "additionalProperties": false,
      "properties": {
        "volume": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "solid": { "$ref": "#/$defs/bitmask" },
        "maxUtilization": { "type": "number", "minimum": 0 },
        "method": { "type": "string" }
      }
    },
    "hints": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "ivec3": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 },
      "minItems": 3,
      "maxItems": 3
    },
    "face": { "enum": ["x-", "x+", "y-", "y+", "z-", "z+"] },
    "bitmask": { "type": "string", "contentEncoding": "base64" },
    "load": {
      "type": "object",
      "required": ["cells", "force"],
      "additionalProperties": false,
      "properties": {
        "cells": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ivec3" } },
        "force": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        }
      }
    }
  }
}
